function conta(s: string, n: integer, c: char): integer {
    var i, total: integer;
    i = 0;
    total = 0;
    while (i < n) {
        var atual: char;
        atual = s[i++];
        if (atual == c) total = total + 1;
    }
    return total;
}

function inverte(s: string, l: integer): string {
    var i: integer;
    var c: char;
    i = 0;
    l = l - 1;
    while (i < l) {
        var tmp: char;
        c = s[i];
        s[i++] = s[l];
        s[l--] = c;
    }
    return s;
}
